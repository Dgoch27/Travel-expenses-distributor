rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per trip. Only signed-in, email-verified people listed in `members` can use it.
    match /trips/{tripId} {
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.token.email];

      allow read: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in resource.data.members;

      // Members can edit the trip; only the owner can change who has access.
      allow update: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in resource.data.members
        && request.resource.data.owner == resource.data.owner
        && (request.resource.data.members == resource.data.members
            || resource.data.owner == request.auth.uid);

      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
  }
}
